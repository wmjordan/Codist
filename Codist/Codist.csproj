<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net461</TargetFramework>
		<OutputType>Library</OutputType>
		<RootNamespace>Codist</RootNamespace>
		<AssemblyName>Codist</AssemblyName>
		<Configurations>Debug;Release;ReleaseLogged</Configurations>

		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<OutputPath Condition="'$(Configuration)' == 'Debug'">bin\Debug\</OutputPath>
		<OutputPath Condition="'$(Configuration)' == 'Release'">bin\Release\</OutputPath>
		<OutputPath Condition="'$(Configuration)' == 'ReleaseLogged'">bin\Release\</OutputPath>

		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ErrorReport>prompt</ErrorReport>

		<VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
		<GeneratePkgDefFile>true</GeneratePkgDefFile>
		<UseCodeBase>true</UseCodeBase>
		<IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
		<IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
		<IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
		<CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
		<CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
		<UICulture>en-US</UICulture>

		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>Key.snk</AssemblyOriginatorKeyFile>

		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<DefaultItemExcludes>$(DefaultItemExcludes);
			Properties\Resources.resx;
			VSPackage.resx;
			Commands\**\*.vsct;
			Controls\SymbolList.xaml;
			Controls\ThemedControls.xaml;
			Controls\VirtualList.xaml;
			Controls\NavigationBar.xaml;
			Controls\ContextMenu.xaml;
			Resources\wechatQrcode.png
		</DefaultItemExcludes>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DefineConstants>TRACE</DefineConstants>
		<DebugType>none</DebugType>
		<Optimize>true</Optimize>
		<DeployExtension>False</DeployExtension>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'ReleaseLogged'">
		<DefineConstants>TRACE;LOG</DefineConstants>
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<DeployExtension>False</DeployExtension>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="CLR"><HintPath>Lib\CLR.dll</HintPath></Reference>
		<Reference Include="Markdig"><HintPath>Lib\Markdig.dll</HintPath></Reference>
		<Reference Include="System.Buffers"><HintPath>Lib\System.Buffers.dll</HintPath></Reference>
		<Reference Include="System.Memory"><HintPath>Lib\System.Memory.dll</HintPath></Reference>
		<Reference Include="System.Runtime.CompilerServices.Unsafe">
			<HintPath>Lib\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
		</Reference>

		<Reference Include="Microsoft.CSharp" />
		<Reference Include="Microsoft.VisualStudio.CommandBars, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a">
			<EmbedInteropTypes>False</EmbedInteropTypes>
		</Reference>
		<Reference Include="System.ComponentModel.Composition" />
		<Reference Include="System.Management" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="envdte80" Version="8.0.3">
			<EmbedInteropTypes>True</EmbedInteropTypes>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.EditorFeatures.Text" Version="2.10.0" />
		<PackageReference Include="Microsoft.VisualStudio.ComponentModelHost" Version="15.8.525" />
		<PackageReference Include="Microsoft.VisualStudio.Editor" Version="15.8.525" />
		<PackageReference Include="Microsoft.VisualStudio.Language.Intellisense" Version="15.8.525" />
		<PackageReference Include="Microsoft.VisualStudio.Language.StandardClassification" Version="15.8.525" />
		<PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="2.10.0" />
		<PackageReference Include="Microsoft.VisualStudio.ProjectSystem" Version="15.8.243" />
		<PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
		<PackageReference Include="Microsoft.VisualStudio.SDK.Analyzers" Version="17.7.79" PrivateAssets="all" />
		<PackageReference Include="Microsoft.VisualStudio.SDK.EmbedInteropTypes" Version="15.0.36" />
		<PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="15.9.28307" />
		<PackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf" Version="15.8.525" />
		<PackageReference Include="Microsoft.VisualStudio.Threading" Version="15.8.168" />
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15" PrivateAssets="all" />
		<PackageReference Include="Microsoft.VisualStudio.Validation" Version="15.5.31" />
		<PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.12.1606" PrivateAssets="all" />
		<PackageReference Include="Microsoft.Xml.SgmlReader" Version="1.8.30" />
		<PackageReference Include="NETStandard.Library" Version="2.0.0" />
		<PackageReference Include="SharpYaml" Version="2.1.4" />
		<PackageReference Include="System.IO" Version="4.3.0" />
		<PackageReference Include="System.Net.Http" Version="4.3.4" />
		<PackageReference Include="System.Net.Primitives" Version="4.3.1" />
		<PackageReference Include="System.ObjectModel" Version="4.3.0" />
		<PackageReference Include="System.Reflection.Extensions" Version="4.3.0" />
		<PackageReference Include="System.Reflection.Primitives" Version="4.3.0" />
		<PackageReference Include="System.Runtime.Handles" Version="4.3.0" />
		<PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
		<PackageReference Include="System.Threading.Timer" Version="4.3.0" />
		<PackageReference Include="System.ValueTuple" Version="4.5.0" />
		<PackageReference Include="System.Xml.ReaderWriter" Version="4.3.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectCapability Include="CreateVsixContainer" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Properties\Resources.resx" Generator="ResXFileCodeGenerator">
			<SubType>Designer</SubType>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</None>
		<None Include="VSPackage.resx">
			<SubType>Designer</SubType>
			<AutoGen>True</AutoGen>
			<DesignTime>True</DesignTime>
			<ManifestResourceName>VSPackage</ManifestResourceName>
		</None>

		<Compile Update="Properties\Resources.Designer.cs">
			<AutoGen>True</AutoGen>
			<DesignTime>True</DesignTime>
			<DependentUpon>Resources.resx</DependentUpon>
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<VSCTCompile Include="Commands\CodistPackage.en-US.vsct">
			<ResourceName>Menus.ctmenu</ResourceName>
			<SubType>Designer</SubType>
		</VSCTCompile>
		<VSCTCompile Include="Commands\CodistPackage.zh-Hans.vsct">
			<ResourceName>Menus.ctmenu</ResourceName>
			<SubType>Designer</SubType>
		</VSCTCompile>
		<None Include="Commands\CodistPackage.vsct">
			<ResourceName>Menus.ctmenu</ResourceName>
		</None>
	</ItemGroup>
	
	<ItemGroup>
		<EmbeddedResource Update="VSPackage.en-US.resx">
			<MergeWithCTO>true</MergeWithCTO>
			<LogicalName>VSPackage.en-US.resources</LogicalName>
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="VSPackage.zh-Hans.resx">
			<MergeWithCTO>true</MergeWithCTO>
			<LogicalName>VSPackage.zh-Hans.resources</LogicalName>
			<SubType>Designer</SubType>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Controls\SymbolList.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Resource>
		<Resource Include="Controls\ThemedControls.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Resource>
		<Resource Include="Controls\VirtualList.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Resource>
		<Resource Include="Controls\NavigationBar.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Resource>
		<Resource Include="Controls\ContextMenu.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Resource>

		<Resource Include="Resources\wechatQrcode.png" />
	</ItemGroup>

	<ItemGroup>
		<None Update="source.extension.vsixmanifest">
			<SubType>Designer</SubType>
		</None>
		<None Include="Key.snk" />
		<None Include="Resources\Dark Codist.json" />
		<None Include="Resources\Dark Pale Codist.json" />
		<None Include="Resources\Light Codist.json" />
		<None Include="Resources\Light Pale Codist.json" />
		<None Include="Resources\Simple Codist.json" />

		<Content Include="zh-Hans\Extension.vsixlangpack">
			<IncludeInVSIX>true</IncludeInVSIX>
			<SubType>Designer</SubType>
		</Content>
		<Content Include="icon.png" CopyToOutputDirectory="Always">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="license.txt">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="preview.png" CopyToOutputDirectory="Always">
			<IncludeInVSIX>true</IncludeInVSIX>
		</Content>
		<Content Include="Resources\CodistPackage.ico" />
	</ItemGroup>

</Project>
